# /etc/thornbots/launch.env: per-robot config for thornbots.service.
# install.sh writes this with the workspace, UID and GID filled in; blank
# values are auto-detected at start. After editing:
#   sudo systemctl restart thornbots

# Host workspace, mounted at /workspaces/isaac_ros-dev. Owner sets UID/GID.
ISAAC_ROS_WS_HOST=
HOST_USER_UID=
HOST_USER_GID=

# Blank: newest nvcr.io/nvidia/isaac/ros:isaac_ros-realsense-thornbots_*-arm64-jetpack.
THORNBOTS_IMAGE=
# false: run the packages baked into the image (/workspaces/ros2_ws).
# true: overlay the workspace's colcon install/ on top.
USE_WS_OVERLAY=false
ROS_DOMAIN_ID=1

# Relative to ISAAC_ROS_WS_HOST. Without the engine, TensorRT builds it from
# the ONNX on first start (minutes) and later starts load it.
ENGINE_REL_PATH=isaac_ros_assets/models/yolo11/yolo11s_fp16.plan
ONNX_REL_PATH=isaac_ros_assets/models/yolo11/best.onnx
NUM_CLASSES=8
CONFIDENCE_THRESHOLD=0.25
NMS_THRESHOLD=0.45

# Target selection (auto.launch.py's target_selector).
CENTER_WEIGHT=1.0
PRIORITY_CLASS_BONUS=0.5
PRIORITY_CLASS_IDS=[2,6]

# The lidar hotplugs, so it is read through the host's /dev at /host-dev;
# /dev/rplidar is its udev name (sllidar_ros2/scripts/rplidar.rules).
LIDAR_SERIAL_DEVICE=/host-dev/rplidar
# mapping: a blank map from the boot pose, saved every 30 s under the
# workspace's maps/<boot time>/. amcl needs a saved map of this field.
LOCALIZATION_MODE=mapping

# Snapshots for training data, saved under SNAPSHOT_OUTPUT_HOST.
ENABLE_SNAPSHOT=False
SNAPSHOT_OUTPUT_HOST=/data/realsense-captures

# Extra name:=value args for each launch, space-separated.
AUTO_LAUNCH_ARGS=
YOLO_LAUNCH_ARGS=

# Per run: thornbots-run<N>.log, and thornbots-run<N>/ with the MCAP bag
# (bag/) and ROS node logs (ros/); latest.log and latest point at the newest.
# Blank: /var/log/thornbots.
LOG_DIR=
# Record the bag (thornbots-launch.sh lists its topics).
ENABLE_BAG=true
# At start, delete the oldest runs while LOG_DIR's disk has under
# LOG_MIN_FREE_GB free, always keeping the newest LOG_KEEP_RUNS.
LOG_MIN_FREE_GB=20
LOG_KEEP_RUNS=5
