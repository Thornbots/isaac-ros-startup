[Unit]
Description=Consume and validate battle Wi-Fi disconnect request

[Service]
Type=oneshot
ExecStart=/usr/local/lib/thornbots/match-wifi-off
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/thornbots-net
# The system D-Bus socket remains accessible for NetworkManager.
RestrictAddressFamilies=AF_UNIX
