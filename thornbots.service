# /etc/systemd/system/thornbots.service: the robot stack at boot (Jazzy).
# Installed by install.sh. Logs: journalctl -u thornbots -f
# Debug by hand: sudo /usr/local/bin/thornbots-start.sh
# No network-online wait: the robot runs air-gapped, and waiting costs boot
# time. Nodes started before Wi-Fi is up aren't reachable over tailscale.
# see README.md for design rationale

[Unit]
Description=Thornbots robot stack (Isaac ROS container)
Documentation=https://github.com/Thornbots/isaac-ros-startup
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f thornbots-runtime
ExecStart=/usr/local/bin/thornbots-start.sh
ExecStop=/usr/bin/docker stop --time 15 thornbots-runtime
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30
KillMode=mixed
SyslogIdentifier=thornbots

[Install]
WantedBy=multi-user.target
